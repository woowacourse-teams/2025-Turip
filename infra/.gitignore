# Terraform state — S3 backend 사용. 로컬에 떨어지는 state도 혹시 몰라 제외
*.tfstate
*.tfstate.*
*.tfstate.backup

# 크래시 로그
crash.log
crash.*.log

# 프로바이더/모듈 캐시
.terraform/
.terraform.lock.hcl

# 로컬 오버라이드
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# 민감 값이 들어갈 수 있는 개인 tfvars
*.auto.tfvars

# archive_file data source 산출물(zip 빌드 결과)
# 디렉터리 자체는 archive_file이 생성하지 않으므로 .gitkeep으로 존재를 보장
build/*
!build/.gitkeep
